{
  "manifest_version": 3,
  "name": "Free4talk Pro",
  "description": "Free4talk Pro 2027 Edition - Powerful tools to enhance your Free4Talk experience with macOS glass UI and user insights.",
  "version": "27.0.0",
  "author": {
    "email": "info@free4talk.me"
  },
  "homepage_url": "https://github.com/Riajul18-19/free4talk-pro",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "identity",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "https://www.youtube.com/*"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://free4talk.com/*",
        "https://www.free4talk.com/*"
      ],
      "resources": [
        "assets/api-Clt9UHcG.js",
        "assets/config-wRKgJ-WU.js",
        "assets/logger-C6gXeMnu.js",
        "assets/dmBridge-DfkPn0Zq.js",
        "assets/spotify-8CrGHF_Z.js",
        "assets/ytRemote-BcbPVE8e.js",
        "assets/main-PWpBs9g2.js",
        "assets/content.tsx-Cfr-pRWd.js",
        "assets/mainWorldBridge.ts-CnE3Edd9.js",
        "assets/theme.css"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "resources": [
        "assets/ytRemote-BcbPVE8e.js",
        "assets/ytRemote.ts-ZzSItsd7.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "icons": {
    "16": "public/logo.png",
    "32": "public/logo.png",
    "48": "public/logo.png",
    "128": "public/logo.png"
  },
  "action": {
    "default_icon": {
      "16": "public/logo.png",
      "32": "public/logo.png",
      "48": "public/logo.png",
      "128": "public/logo.png"
    },
    "default_title": "Free4talk Pro",
    "default_popup": "src/popup/index.html"
  },
  "host_permissions": [
    "https://free4talk.com/*",
    "https://www.free4talk.com/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/content.tsx-loader-BbqEcBvJ.js"
      ],
      "matches": [
        "https://free4talk.com/*",
        "https://www.free4talk.com/*"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "assets/mainWorldBridge.ts-loader-CmahrsA1.js"
      ],
      "matches": [
        "https://free4talk.com/*",
        "https://www.free4talk.com/*"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
